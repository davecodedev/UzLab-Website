// UzLab core schema — v1 (MVP) models only.
// Deferred modules (Technical Committee, Equipment, Career, Professional
// Development) are NOT modeled here yet — see docs/ARCHITECTURE.md for how
// they plug in later without touching these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & identity -------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  MEMBER
  APPLICANT
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          UserRole  @default(APPLICANT)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  refreshTokens          RefreshToken[]
  member                 Member?
  membershipApplications MembershipApplication[]
  payments               Payment[]
  contactSubmissions     ContactSubmission[]
  laboratoryClaims       LaboratoryClaim[]
  submittedLaboratories  Laboratory[]            @relation("SubmittedLaboratories")
  postedVacancies        Vacancy[]               @relation("PostedVacancies")
  jobApplications        JobApplication[]        @relation("SubmittedApplications")
  candidateProfile       CandidateProfile?

  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- Membership --------------------------------------------------------

enum MembershipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model MembershipType {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String
  priceCents   Int
  currency     String   @default("UZS")
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications MembershipApplication[]
  members      Member[]
  payments     Payment[]
}

model MembershipApplication {
  id               String                      @id @default(uuid())
  applicantUserId  String
  applicant        User                        @relation(fields: [applicantUserId], references: [id])
  membershipTypeId String
  membershipType   MembershipType              @relation(fields: [membershipTypeId], references: [id])
  status           MembershipApplicationStatus @default(PENDING)
  organization     String?
  phone            String
  notes            String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status])
}

/// Where a membership stands, independently of whether it has expired.
///
/// Paying does not by itself open the member area: a payment creates the
/// membership as PENDING_APPROVAL and an administrator admits it. FROZEN is
/// for a member who has stopped paying or is late — it suspends access without
/// destroying the record or the time already bought, so unfreezing restores
/// exactly what was there.
enum MemberStatus {
  PENDING_APPROVAL
  ACTIVE
  FROZEN
}

model Member {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id])
  membershipTypeId  String
  membershipType    MembershipType @relation(fields: [membershipTypeId], references: [id])
  organization      String?
  isDirectoryListed Boolean        @default(true)
  memberSince       DateTime       @default(now())
  expiresAt         DateTime?

  /// Defaults to ACTIVE so memberships that predate the approval step keep
  /// working; only new paid ones are created PENDING_APPROVAL.
  status MemberStatus @default(ACTIVE)

  /// Who admitted, froze or unfroze this membership, and why. Recorded rather
  /// than inferred: suspending someone's paid access is a human decision and
  /// should be attributable.
  reviewedByUserId String?
  reviewedAt       DateTime?
  statusNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDirectoryListed])
  @@index([status])
}

// --- Laboratory Registry --------------------------------------------------
// A public directory of laboratories (not necessarily UzLab members) —
// distinct from Member/MembershipType above, which track the association's
// own membership. isUzLabMember cross-references the two without merging
// them, since "registered in the national lab registry" and "is a UzLab
// member" are different, overlapping sets.

enum LaboratoryField {
  TESTING
  METROLOGY
  MEDICINE
  ECOLOGY
  INDUSTRY
  AGRICULTURE
  FOOD
  CONSTRUCTION
  OTHER
}

enum AccreditationStatus {
  ACCREDITED
  SUSPENDED
  EXPIRED
  WITHDRAWN
  PENDING
  UNKNOWN
}

// The national register covers more than laboratories — it also lists
// certification bodies, inspection bodies, proficiency-testing providers and
// reference-material producers. Keyed by O'zAkk's own `type_std.key` so the
// mapping back to the source stays exact.
enum ConformityBodyType {
  TESTING_LAB // SL — Sinov laboratoriyasi
  METROLOGY_SERVICE // QL — o'lchash vositalarini qiyoslash metrologiya xizmati
  CALIBRATION_LAB // KL — Kalibrlash laboratoriyasi
  NDT_LAB // PT — putur yetkazmasdan tekshirish laboratoriyasi
  MEDICAL_LAB // TL — Tibbiy laboratoriya
  PRODUCT_CERTIFICATION // MS — Mahsulot sertifikatlash organi
  MANAGEMENT_CERTIFICATION // MT — Menejment tizimlarini sertifikatlashtirish organi
  SERVICE_CERTIFICATION // XO — Xizmatlarni sertifikatlash organi
  PERSONNEL_CERTIFICATION // XS — Xodimlarni sertifikatlashtirish organi
  INSPECTION_BODY // IO — Inspeksiya organlari
  PROFICIENCY_PROVIDER // MP — Malakani tekshirish provayderlari
  REFERENCE_MATERIAL_PRODUCER // SN — Standart namunalar ishlab chiqaruvchi
  OTHER_BODY
}

// Where a record came from — matters once bulk government-sourced imports
// start alongside self-registration and manual admin entry.
enum LaboratorySource {
  SELF_REGISTERED
  GOVERNMENT_IMPORT
  MANUAL_ENTRY
}

// Uzbekistan runs more than one national register, and a single physical
// laboratory can legitimately appear in several of them under different
// numbers — O'zAkk accreditation and Depstan measurement-approval are
// separate authorisations, not duplicates of each other.
enum NationalRegister {
  AKKRED // akkred.uz — O'zbekiston akkreditatsiya markazi (O'ZAKK)
  DEPSTAN // approval.depstan.uz — testing-laboratory approval register
}

model Laboratory {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  fields              LaboratoryField[]   @default([])
  accreditationNumber String?             @unique
  accreditationBody   String?
  accreditationStatus AccreditationStatus @default(UNKNOWN)
  accreditedUntil     DateTime?
  taxId               String?
  region              String?
  city                String?
  address             String?
  phone               String?
  email               String?
  website             String?
  description         String?
  isUzLabMember       Boolean             @default(false)
  isPublished         Boolean             @default(true)
  source              LaboratorySource    @default(MANUAL_ENTRY)

  // --- National register detail (O'zAkk / akkred.uz) --------------------
  // Populated by scripts/import-akkred-registry.ts from the public register
  // API. All optional: a self-registered lab has none of these.
  register            NationalRegister? // which national register this row came from
  registerStatusLabel String? // the register's own status wording, before mapping to the enum
  bodyType            ConformityBodyType? // which kind of conformity-assessment body
  bodyTypeLabel       String? // O'zAkk's own Uzbek label for the type
  isLaboratory        Boolean             @default(true) // false for certification/inspection bodies
  externalId          Int? // O'zAkk internal numeric id
  externalUid         String? // O'zAkk uuid
  legalEntityName     String? // parent legal entity (often differs from the body's own name)
  legalEntityAddress  String? // registered legal address
  supervisorName      String? // head of the laboratory / body
  standard            String? // e.g. "O'z DSt ISO/IEC 17025:2019"
  accreditationDate   DateTime? // first accreditation
  reAccreditationDate DateTime?
  statusDate          DateTime? // date the current status took effect
  certificateUrl      String? // accreditation certificate PDF (hosted by O'zAkk)
  scopeUrl            String? // scope-of-accreditation PDF (hosted by O'zAkk)
  scopeText           String? // full scope table as plain text
  directions          String[]            @default([]) // industry sectors covered

  /// Script-neutral search key: every searchable field folded to bare lowercase
  /// Latin by common/utils/translit.ts, including the full scope text. Lets a
  /// query typed in Uzbek Latin match a document written in Cyrillic, which no
  /// Postgres text-search configuration does — there is no Uzbek stemmer, and
  /// the registers mix scripts inside single documents.
  ///
  /// Derived, never displayed. Rebuilt by scripts/rebuild-search-index.ts and
  /// kept current by the importers.
  searchText String?

  // Source lifecycle. A scheduled re-import refreshes every row it still finds
  // upstream; rows the source has stopped listing keep their data but get
  // stamped `disappearedAt` rather than being deleted, so a bad scrape can
  // never silently erase the register.
  lastSeenAt    DateTime?
  disappearedAt DateTime?

  // Member-submitted entries: laboratories that appear in neither national
  // register and were added through the site. They carry the same fields as
  // scraped rows so they are findable through exactly the same filters, but
  // `source` keeps them honestly distinguishable — their data is self-declared,
  // not verified against a register. They stay unpublished until staff approve.
  //
  // The scheduled imports cannot touch these: every import scopes its writes
  // and its disappeared-marking to a single `register`, and these have none.
  submittedByUserId String?
  submittedBy       User?     @relation("SubmittedLaboratories", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewNote        String?

  claims    LaboratoryClaim[]
  profile   LaboratoryProfile?
  documents LaboratoryDocument[]
  vacancies Vacancy[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([region])
  @@index([accreditationStatus])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([bodyType])
  @@index([isLaboratory])
  @@index([taxId])
  @@index([register])
  @@index([disappearedAt])
}

// --- Member-owned laboratory data ------------------------------------------
// The register rows in Laboratory are overwritten wholesale on every refresh,
// so nothing a member types may live in them — it would be silently erased by
// the next import. Member contributions live here instead, in their own table,
// and the UI falls back to the register's value when a field is blank.
//
// Official facts (name, number, accreditation status, dates, certificates)
// are deliberately absent: those are determinations by the accreditation body,
// not something a laboratory may restate about itself.

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A member asserting they represent a laboratory. Approval is manual — being
/// able to edit a public register entry is not something to hand out on the
/// strength of a self-service form.
model LaboratoryClaim {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  laboratoryId String
  laboratory   Laboratory  @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  status       ClaimStatus @default(PENDING)

  /// How the claimant says they can be verified — role, work email, phone.
  evidence     String
  contactName  String
  contactEmail String
  contactPhone String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One claim per user per laboratory; re-applying updates the existing row.
  @@unique([userId, laboratoryId])
  @@index([status])
  @@index([laboratoryId])
}

/// Supplementary, member-supplied detail for one laboratory. Every field is
/// optional and additive — none of it contradicts the register.
model LaboratoryProfile {
  id           String     @id @default(uuid())
  laboratoryId String     @unique
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  /// Contact details the lab would rather publish than the register's.
  publicPhone   String?
  publicEmail   String?
  publicWebsite String?
  contactPerson String?

  /// Free-text presentation.
  description  String?
  servicesText String?
  workingHours String?

  /// Capabilities the lab wants to be found by, beyond the official scope.
  specialisations String[] @default([])

  logoUrl String?

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Uploaded documents -----------------------------------------------------
// Records imported from a national register link to PDFs hosted by O'zAkk or
// Depstan. A member-added laboratory has no such upstream, so its documents are
// stored here.
//
// The bytes live in Postgres rather than object storage: there is no S3 bucket
// configured, and at ~175 KB per scope document this stays small for a long
// while. If member uploads ever run to thousands, these rows are the first
// thing to move out — the table is deliberately separate from Laboratory so
// that migration touches nothing else, and so a listing query never drags
// megabytes of PDF along with it.

enum LaboratoryDocumentKind {
  CERTIFICATE
  SCOPE
}

model LaboratoryDocument {
  id           String                 @id @default(uuid())
  laboratoryId String
  laboratory   Laboratory             @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  kind         LaboratoryDocumentKind

  filename  String
  mimeType  String
  sizeBytes Int
  data      Bytes

  /// Text layer pulled out at upload time, so an uploaded document is as
  /// searchable as a scraped one. Null when the PDF had no extractable text.
  extractedText String?

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  /// One document of each kind per laboratory; re-uploading replaces it.
  @@unique([laboratoryId, kind])
  @@index([laboratoryId])
}

// --- Import auditing -------------------------------------------------------
// Every scheduled refresh writes one row here, including the runs that refused
// to write. Without this a scrape that breaks and imports plausible-but-wrong
// data looks identical to a healthy one.

enum ImportRunStatus {
  SUCCESS
  NO_CHANGES // change detection found nothing new; full crawl skipped
  REFUSED // sanity checks failed — nothing was written
  FAILED // crawl or write errored out
}

model ImportRun {
  id String @id @default(uuid())

  // Exactly one of these is set. A run refreshes either a laboratory register
  // or a standards catalogue, and the two have nothing in common but this
  // audit trail — keeping them in one table is what lets /admin/imports and the
  // public provenance block answer "when was this last checked?" the same way
  // for every source on the site.
  register         NationalRegister?
  standardRegister StandardRegister?

  status  ImportRunStatus
  trigger String          @default("manual") // "cron" | "manual"

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  // Counts. `scraped` is what the source offered; the rest is what we did.
  scraped       Int @default(0)
  created       Int @default(0)
  updated       Int @default(0)
  disappeared   Int @default(0)
  reappeared    Int @default(0)
  fetchFailures Int @default(0)

  message  String? // refusal reason or short human summary
  warnings String[] @default([])

  @@index([register, startedAt])
  @@index([standardRegister, startedAt])
  @@index([startedAt])
}

// --- Media & Contact -----------------------------------------------------

model NewsArticle {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  summary       String
  bodyText      String
  coverImageUrl String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([publishedAt])
  @@index([deletedAt])
}

enum ContactSubmissionType {
  CONTACT
  FEEDBACK
}

enum ContactSubmissionStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

model ContactSubmission {
  id        String                  @id @default(uuid())
  type      ContactSubmissionType
  name      String
  email     String
  message   String
  status    ContactSubmissionStatus @default(NEW)
  userId    String?
  user      User?                   @relation(fields: [userId], references: [id])
  createdAt DateTime                @default(now())

  @@index([status])
}

// --- Standards catalogue -------------------------------------------------

// Where a standard was read from. Neither is an accreditation register: these
// are catalogues of the documents laboratories are accredited *against*, which
// is why they are a separate entity rather than more columns on Laboratory.
enum StandardRegister {
  MGS // mgscatalog.by — EASC interstate (GOST) catalogue, published from Belarus
  UZSTI // uzsti.uz — O'zbekiston Standartlar Instituti
  ISO // iso.org open data — published under ODC-By v1.0, not scraped
  CEN // standards.cencenelec.eu — the CEN and CENELEC European catalogues
}

// Each catalogue words its own state differently ("Введен впервые", "Заменен",
// "amalda"); `statusLabel` keeps the original and this is the mapping the
// filters use.
enum StandardStatus {
  IN_FORCE
  SUPERSEDED // replaced by a newer document
  WITHDRAWN // cancelled without replacement
  NOT_YET_IN_FORCE // adopted, effective date still in the future
  UNKNOWN
}

model Standard {
  id       String           @id @default(uuid())
  slug     String           @unique
  register StandardRegister

  /// The catalogue's own identifier — UrlRN for MGS, the numeric id for UZSTI.
  /// Unique only within a register: the two catalogues number independently.
  sourceId  String
  sourceUrl String

  /// "ГОСТ EN 581-1-2022", "OʻzMSt ISO 6993-4:2026" — how the document is cited.
  designation String
  title       String
  /// Область применения / anotatsiya — what the document actually covers.
  abstract    String?

  status      StandardStatus @default(UNKNOWN)
  /// The catalogue's own wording, kept verbatim beside the mapped enum.
  statusLabel String?

  /// Top-level ICS group — "75". Kept two-digit across all sources so one
  /// filter works over the whole catalogue.
  icsCode  String?
  /// The source's own wording for that group, in the source's own language.
  icsLabel String?
  /// Full ICS codes as the source gives them — "21.060.10". ISO assigns
  /// several per document; the other catalogues publish only the group.
  icsCodes String[] @default([])
  /// The catalogue's own grouping — "Milliy standartlar", "ГОСТ - межгосударственные стандарты".
  category String?
  language String?

  year      Int?
  pageCount Int?
  /// UZSTI sells its documents; MGS does not. Stored in so'm, as published.
  priceUzs  Int?

  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  // --- Detail-page fields (MGS) ------------------------------------------
  // The listing crawl covers every document; these come from the per-document
  // page, which is fetched gradually afterwards. `detailFetchedAt` null means
  // this row is listing-only so far — not that the source has no detail.
  developer          String?
  technicalCommittee String?
  adoptingStates     String[]  @default([])
  detailFetchedAt    DateTime?

  /// Folded, script-neutral search key — see Laboratory.searchText.
  searchText String?

  // Lifecycle, exactly as the laboratory registers: a document the catalogue
  // stops listing is stamped, never deleted.
  lastSeenAt    DateTime?
  disappearedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([register, sourceId])
  @@index([register])
  @@index([status])
  @@index([icsCode])
  @@index([year])
  @@index([disappearedAt])
  @@index([deletedAt])
  @@index([detailFetchedAt])
}

/// The International Classification for Standards, from ISO's open data.
///
/// A reference table rather than columns on Standard: the same 40 top-level
/// groups are used by every catalogue we hold, each in its own wording, and
/// this is the one canonical naming for them. Three levels deep — "21",
/// "21.060", "21.060.10" — linked by `parent`.
///
/// Sourced from the iso_ics dataset, ODC-By v1.0. See ATTRIBUTION in the
/// standards catalogue UI.
model IcsClass {
  code   String  @id
  parent String?

  titleEn String
  scopeEn String?

  /// 0 for "21", 1 for "21.060", 2 for "21.060.10".
  level Int

  updatedAt DateTime @updatedAt

  @@index([parent])
  @@index([level])
}

// --- Payments --------------------------------------------------------------

// The gateways Uzbekistan actually uses. Stripe does not operate here, and
// both of these invert the usual flow: we never charge a card, we expose an
// endpoint they call once the payer has authorised it on their side. Card
// details never reach this system.
enum PaymentGateway {
  PAYME // JSON-RPC merchant API, amounts in tiyin
  CLICK // Prepare/Complete callbacks, MD5-signed
  /// Bank transfer against an invoice, confirmed by staff against the
  /// statement. No gateway is involved, which is why this one may be raised in
  /// a currency the gateways cannot settle.
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING // invoice raised, nobody has paid yet
  HELD // gateway created a transaction and is holding it
  PAID // money taken; membership extended
  CANCELLED // abandoned or reversed before completion
  REFUNDED // reversed after completion
}

/// One membership purchase.
///
/// Created before the payer is sent to the gateway, so there is always a local
/// record to check a callback against — the amount in a callback is never
/// trusted, it is compared with this row.
model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  membershipTypeId String
  membershipType   MembershipType @relation(fields: [membershipTypeId], references: [id])

  gateway PaymentGateway
  status  PaymentStatus  @default(PENDING)

  /// Minor units, as the gateways expect: tiyin for so'm. Fixed when the
  /// invoice is raised so a later price change cannot alter what was agreed.
  amountMinor Int
  currency    String @default("UZS")

  /// How many days of membership this buys, copied from the type at purchase
  /// time for the same reason.
  durationDays Int

  // --- Bank transfer ------------------------------------------------------

  /// Human-readable reference the payer quotes on the transfer, and the thing
  /// staff match against the bank statement. Sequential per year.
  invoiceNumber String? @unique

  /// Who the invoice is made out to. Asked for because a laboratory's
  /// accounts department needs its own legal name and tax id on the document,
  /// which are not the same as the account holder's name.
  payerName  String?
  payerTaxId String?

  /// Set when staff confirm the money arrived. Recorded rather than inferred:
  /// granting a membership off a bank statement is a human decision, and it
  /// should be attributable.
  confirmedByUserId String?
  confirmedAt       DateTime?
  staffNote         String?

  /// The gateway's own transaction id. Unique so a repeated callback — they do
  /// retry — cannot be processed twice.
  gatewayTransactionId String? @unique
  /// Gateway-side creation time, in their epoch milliseconds.
  gatewayCreatedAt     BigInt?
  gatewayPerformedAt   BigInt?
  gatewayCancelledAt   BigInt?
  /// Gateway's reason code for a cancellation, kept verbatim.
  cancelReason         Int?

  paidAt DateTime?

  /// The last callback body, for reconciling a disputed payment.
  lastCallback Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gateway, status])
  @@index([createdAt])
}

// --- Careers -----------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum VacancyStatus {
  /// Written but not yet visible to job seekers.
  DRAFT
  PUBLISHED
  /// Withdrawn or filled. Kept so applicants can still see what they applied to.
  CLOSED
}

/// An open position, posted by the organisation that is hiring.
///
/// Deliberately not tied to a Laboratory row: an accredited body may hire, but
/// so may a supplier, a training centre or a ministry, and requiring a register
/// entry would exclude most real employers. `laboratoryId` is set when the
/// poster has a claimed laboratory, and left null otherwise.
model Vacancy {
  id     String @id @default(uuid())
  slug   String @unique
  userId String
  user   User   @relation("PostedVacancies", fields: [userId], references: [id], onDelete: Cascade)

  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)

  title            String
  organisationName String
  region           String?
  city             String?
  employmentType   EmploymentType @default(FULL_TIME)

  /// Free text rather than a number: real postings say "from 8 million", "by
  /// agreement", or nothing at all, and forcing a figure would invent one.
  salary String?

  description  String
  requirements String?

  contactEmail String
  contactPhone String?

  status VacancyStatus @default(PUBLISHED)
  /// Marks a posting as urgent in the listing. Set by the poster.
  urgent Boolean       @default(false)

  publishedAt DateTime?
  /// After this the posting stops appearing, so a filled job does not sit open
  /// for a year because nobody came back to close it.
  expiresAt   DateTime?

  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([userId])
  @@index([region])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

/// One person's application to one vacancy.
model JobApplication {
  id        String  @id @default(uuid())
  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  /// Null for an application sent without an account.
  userId String?
  user   User?   @relation("SubmittedApplications", fields: [userId], references: [id], onDelete: SetNull)

  fullName String
  email    String
  phone    String?
  /// The applicant's own words. A CV upload can follow; this is what a person
  /// can send today without one.
  message  String
  cvUrl    String?

  status       ApplicationStatus @default(SUBMITTED)
  /// The employer's private note. Never returned to the applicant.
  employerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A signed-in applicant applies once per vacancy; re-submitting updates it.
  @@unique([vacancyId, userId])
  @@index([vacancyId, status])
  @@index([userId])
}

enum CandidateVisibility {
  /// Written but not discoverable — the default, so nothing is published by
  /// accident while a profile is still being filled in.
  HIDDEN
  /// Discoverable by employers.
  PUBLISHED
}

/// A job seeker advertising themselves, so employers can find them rather than
/// waiting to be applied to.
///
/// This is personal data about a named individual, which the vacancy side is
/// not, and it is treated differently for that reason: the profile is written
/// by the person it describes, it is hidden until they publish it, and the
/// identifying parts are withheld from anyone not signed in. A CV database
/// readable by the open web is a CV database that gets scraped.
model CandidateProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  /// "Инженер-химик, испытания воды" — the one line an employer scans.
  headline String

  region String?
  city   String?

  /// Which laboratory field they work in, reusing the registry's own vocabulary
  /// so a search here and a search there mean the same thing.
  fields LaboratoryField[] @default([])

  yearsExperience Int?
  /// Their own account of what they do. Free text, their words.
  summary         String
  skills          String[] @default([])
  education       String?
  certifications  String?

  /// A link to a CV hosted elsewhere.
  cvUrl String?

  /// An uploaded CV, stored the same way laboratory documents are. Held beside
  /// `cvUrl` rather than replacing it: some people have a file, some have a
  /// profile page somewhere, and there is no reason to make them choose.
  cvFilename  String?
  cvMimeType  String?
  cvSizeBytes Int?
  cvData      Bytes?

  /// Withheld from anyone not signed in.
  contactEmail String
  contactPhone String?

  visibility CandidateVisibility @default(HIDDEN)
  /// Distinct from visibility: a published profile whose owner is not currently
  /// looking still says so, rather than disappearing and reappearing.
  openToWork Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility, openToWork])
  @@index([region])
}
