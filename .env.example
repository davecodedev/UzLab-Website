# --- Database (apps/api) ---
DATABASE_URL="postgresql://uzlab:uzlab_dev_password@localhost:5432/uzlab?schema=public"

# --- Auth (apps/api) ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Object storage (apps/api) — MinIO locally, S3-compatible in prod ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="uzlab-documents"
S3_ACCESS_KEY_ID="uzlab_minio"
S3_SECRET_ACCESS_KEY="uzlab_minio_password"
S3_FORCE_PATH_STYLE="true"

# --- API server ---
API_PORT=4000
# Comma-separated: the site answers to more than one hostname.
CORS_ORIGIN="http://localhost:3000"
# Where a payer is sent back to after a gateway. Used to build return URLs.
WEB_URL="http://localhost:3000"

# --- Click (apps/api) ---
# All three come from Click's merchant cabinet once the contract is signed.
# Leave them empty and the checkout page hides the card option instead of
# offering a redirect that would fail.
#   CLICK_SERVICE_ID   — "ID сервиса", the number Click sends as service_id
#   CLICK_MERCHANT_ID  — "ID мерчанта", used only to build the checkout URL
#   CLICK_SECRET_KEY   — "Секретный ключ", the MD5 signing key. Never commit it.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# --- Payme (apps/api) ---
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
PAYME_ACCOUNT_FIELD="order_id"

# --- Bank transfer (apps/api) — printed on the invoice ---
BANK_BENEFICIARY=""
BANK_ACCOUNT=""
BANK_NAME=""
BANK_MFO=""
BANK_TAX_ID=""
BANK_OKED=""

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
